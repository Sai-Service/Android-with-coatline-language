<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="20dp">

    <!-- Confetti sits behind everything -->
    <com.example.apinew.ConfettiView
            android:id="@+id/confettiView"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:layout_gravity="top|center_horizontal"
            android:elevation="10dp" />

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:background="@drawable/bg_success_dialog"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
            android:paddingTop="8dp">

        <!-- Checkmark circle — floats above card top -->
        <!-- Replace the check circle FrameLayout anchor with this -->
        <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false">

            <View
                    android:id="@+id/successCheckCircle"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="-52dp"
                    android:background="@drawable/bg_check_circle" />

            <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="-52dp"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

        </FrameLayout>

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Payment Successful"
                android:textColor="#1A1A2E"
                android:textSize="20sp"
                android:textStyle="bold" />

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Transaction recorded successfully"
                android:textColor="#888888"
                android:textSize="13sp" />

        <!-- Divider -->
        <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="20dp"
                android:background="#F0F0F0" />

        <!-- Receipt rows -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_receipt_row"
                android:padding="12dp">

            <include layout="@layout/item_receipt_row"
                    android:id="@+id/rowVehicle" />
            <include layout="@layout/item_receipt_row"
                    android:id="@+id/rowCust" />
            <include layout="@layout/item_receipt_row"
                    android:id="@+id/rowGatePass" />
            <include layout="@layout/item_receipt_row"
                    android:id="@+id/rowPayMethod" />
        </LinearLayout>

        <!-- Amount pill -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_amount_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="14dp">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amount Paid  "
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

            <TextView
                    android:id="@+id/successAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹ 0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
        </LinearLayout>

        <!-- Done button -->
        <Button
                android:id="@+id/successDoneBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_done_button"
                android:text="Done"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

    </LinearLayout>

    <!-- Hidden TextViews for data binding -->
    <TextView android:id="@+id/successVehicleNo"  android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/successCustName"   android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/successPayMethod"  android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/successGatePass"   android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</FrameLayout>