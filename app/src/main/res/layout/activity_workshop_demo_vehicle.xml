<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        xmlns:tools="http://schemas.android.com/tools"
        android:background="@drawable/gradient_background"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ==================== HEADER ==================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <ImageView
                android:id="@+id/amazonImage"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/saiservicelogocp"
                app:layout_constraintWidth_percent="0.55"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <!-- Username & Location row -->
        <LinearLayout
                android:id="@+id/line1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/amazonImage">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USERNAME: "
                    android:textColor="@android:color/black"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="username"
                    android:textColor="#FF5722"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="LOCATION: "
                    android:textColor="@android:color/black"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/locIdTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="locId"
                    android:textColor="#FF5722"
                    android:textSize="13sp"
                    android:textStyle="bold" />

        </LinearLayout>

        <!-- Department row -->
        <LinearLayout
                android:id="@+id/line2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/line1">

            <TextView
                    android:id="@+id/deptTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEPARTMENT: "
                    android:textColor="@android:color/black"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/deptIntent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="locId"
                    android:textColor="#FF5722"
                    android:textSize="13sp"
                    android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Divider line below header -->
    <View
            android:id="@+id/headerDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:background="#22000000"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- ==================== SCROLLABLE CONTENT ==================== -->
    <ScrollView
            android:id="@+id/scrollViewContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbarStyle="outsideOverlay"
            app:layout_constraintTop_toBottomOf="@id/headerDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="32dp">

            <!-- Page Title -->
            <TextView
                    android:id="@+id/testDriveTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="DEMO VEHICLE TEST DRIVE"
                    android:textColor="#0A0A0B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

            <!-- Demo Vehicle History (hidden by default) -->
            <TextView
                    android:id="@+id/vehicleHistory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="#F5F6F8"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/gatepass_textview"
                    android:text="Demo Vehicle History"
                    app:layout_constraintEnd_toEndOf="parent" />

            <!-- Vehicle Out / Vehicle In buttons -->
            <LinearLayout
                    android:id="@+id/vehHistoryLL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                <TextView
                        android:id="@+id/forNewVehicleOut"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:background="@drawable/gatepass_textview"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="Vehicle Out"
                        android:textColor="#F5F6F8"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                <TextView
                        android:id="@+id/forNewVehicleIn"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:text="Vehicle In"
                        android:background="@drawable/gatepass_textview"
                        android:textStyle="bold"
                        android:textColor="#F5F6F8"
                        android:textSize="15sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Capture VEH Number (hidden by default) -->
            <LinearLayout
                    android:id="@+id/captureVehNumberIn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical|center_horizontal"
                    android:visibility="gone"
                    android:layout_marginTop="16dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Capture VEH NO - "
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                <ImageButton
                        android:id="@+id/captureRegNoCameraIn"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/camera"
                        android:elevation="4dp"
                        android:padding="10dp"
                        android:contentDescription="Capture vehicle number" />

            </LinearLayout>

            <!-- Test Drive Out / In buttons (hidden by default) -->
            <LinearLayout
                    android:id="@+id/enableButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="16dp">

                <TextView
                        android:id="@+id/forTestDriveOut"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textColor="#F5F6F8"
                        android:background="@drawable/gatepass_textview"
                        android:textSize="15sp"
                        android:text="Test Drive Out"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="8dp" />

                <TextView
                        android:id="@+id/forTestDriveIn"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textColor="#F5F6F8"
                        android:background="@drawable/gatepass_textview"
                        android:textSize="15sp"
                        android:text="Test Drive In"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Vehicle Number Search -->
            <LinearLayout
                    android:id="@+id/newVehLL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                <EditText
                        android:id="@+id/newVehEditText"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:hint="Vehicle Number"
                        android:inputType="textCapCharacters"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:padding="12dp"
                        android:background="@drawable/edittext_rounded"
                        android:elevation="2dp" />

                <ImageButton
                        android:id="@+id/newVehInButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/search"
                        android:padding="10dp"
                        android:elevation="4dp"
                        android:contentDescription="Search vehicle in" />

                <ImageButton
                        android:id="@+id/newVehOutButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/search"
                        android:padding="10dp"
                        android:elevation="4dp"
                        android:contentDescription="Search vehicle out" />

            </LinearLayout>

            <!-- Gate Pass Number -->
            <TextView
                    android:id="@+id/gatePassNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp"
                    android:padding="10dp"
                    android:background="@drawable/edittext_rounded" />

            <TextView
                    android:id="@+id/gatePassNoNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="NOTE: PLEASE TAKE THE PRINT FROM ERP FOR ABOVE GATEPASS NUMBER"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/red"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:background="@drawable/edittext_rounded" />

            <!-- Table Section Header -->
            <TextView
                    android:id="@+id/regNoDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:text="Details By Vehicle Number"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/black"
                    android:textSize="15sp" />

            <!-- Scrollable Table -->
            <HorizontalScrollView
                    android:id="@+id/tableScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <TableLayout
                        android:id="@+id/tableLayout2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:stretchColumns="1" />

            </HorizontalScrollView>

            <!-- ========== FORM FIELDS ========== -->

            <!-- Customer Name -->
            <TextView
                    android:id="@+id/custNameTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Enter customer name:"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <EditText
                    android:id="@+id/custNameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Enter Customer Name"
                    android:inputType="textCapCharacters"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded"
                    android:elevation="2dp"
                    android:layout_marginTop="6dp" />

            <!-- Customer Contact -->
            <TextView
                    android:id="@+id/custContactTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Enter customer contact:"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <EditText
                    android:id="@+id/custContactEditText"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Enter Customer Contact"
                    android:inputType="phone"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded"
                    android:elevation="2dp"
                    android:layout_marginTop="6dp" />

            <!-- Customer Address -->
            <TextView
                    android:id="@+id/custAddressTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Enter customer address:"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <EditText
                    android:id="@+id/custAddressEditText"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Enter Customer Address"
                    android:inputType="textCapCharacters"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded"
                    android:elevation="2dp"
                    android:layout_marginTop="6dp" />

            <!-- Executive Name -->
            <TextView
                    android:id="@+id/salesExecutiveTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Enter Executive Name:"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <EditText
                    android:id="@+id/executiveSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Enter Executive Name"
                    android:inputType="textCapCharacters"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded"
                    android:elevation="2dp"
                    android:layout_marginTop="6dp" />


            <TextView
                    android:id="@+id/authByTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Enter Authorised By:"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <EditText
                    android:id="@+id/authByField"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Authorised By"
                    android:inputType="textCapCharacters"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded"
                    android:elevation="2dp"
                    android:layout_marginTop="6dp" />


            <TextView
                    android:id="@+id/sobInvTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Enter Enquiry/DMS No.:"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <EditText
                    android:id="@+id/sobInvField"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Enquiry/DMS No."
                    android:inputType="textCapCharacters"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:background="@drawable/edittext_rounded"
                    android:elevation="2dp"
                    android:layout_marginTop="6dp" />

            <!-- Current KMs -->
            <TextView
                    android:id="@+id/kmTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Enter the current KM's"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                <EditText
                        android:id="@+id/currentKMSField"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:hint="Enter Current Km"
                        android:inputType="textCapCharacters"
                        android:textSize="14sp"
                        android:padding="12dp"
                        android:background="@drawable/edittext_rounded"
                        android:elevation="2dp" />

                <ImageButton
                        android:id="@+id/captureToKm"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/camera"
                        android:contentDescription="Capture KM reading" />

            </LinearLayout>

            <!-- Remarks -->
            <TextView
                    android:id="@+id/remarksTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Enter Remarks"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <EditText
                    android:id="@+id/remarksField"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Enter Remarks"
                    android:inputType="textCapCharacters"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/edittext_rounded"
                    android:elevation="2dp" />

            <!-- Fuel Quantity -->
            <TextView
                    android:id="@+id/fuelTripTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Enter Fuel Quantity"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <EditText
                    android:id="@+id/fuelTripField"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Enter Fuel Quantity"
                    android:inputType="number"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/edittext_rounded"
                    android:elevation="2dp" />

            <!-- Gate Type Spinner -->
            <TextView
                    android:id="@+id/gateTypeTxtView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Gate Type"
                    android:layout_marginTop="16dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <Spinner
                    android:id="@+id/gateTypeLov"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/modern_spinner_background" />

            <!-- ========== ACTION BUTTONS ========== -->

            <TextView
                    android:id="@+id/newVehicleInPremises"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="#F5F6F8"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/gatepass_textview"
                    android:text="Vehicle In"
                    android:layout_marginTop="24dp" />

            <TextView
                    android:id="@+id/newVehicleOutPremises"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:textStyle="bold"
                    android:textColor="#F5F6F8"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/gatepass_textview"
                    android:text="Vehicle Out" />

            <!-- Refresh buttons -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="16dp">

                <TextView
                        android:id="@+id/refreshButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textColor="#F5F6F8"
                        android:textSize="15sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/gatepass_textview"
                        android:text="REFRESH"
                        android:layout_marginEnd="8dp" />

                <TextView
                        android:id="@+id/refresh"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textColor="#F5F6F8"
                        android:textSize="15sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/gatepass_textview"
                        android:text="REFRESH"
                        android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>