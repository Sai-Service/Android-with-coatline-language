                    android:layout_width="0dp"
                    android:layout_height="65dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="Upload"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    app:backgroundTint="#27AE60"
                    app:cornerRadius="20dp"
                    app:elevation="10dp"
                    app:icon="@drawable/ic_upload"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:rippleColor="#80FFFFFF"
                    android:gravity="center"
                    android:textAlignment="center"/>

<!--                //reset button-->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetButton"
                    android:layout_width="0dp"
                    android:layout_height="65dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="Reset"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    app:backgroundTint="#FFBB86FC"
                    app:cornerRadius="20dp"
                    app:elevation="10dp"
                    app:icon="@drawable/ic_reset"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:rippleColor="#80FFFFFF"
                    android:gravity="center"
                    android:textAlignment="center"/>
            </LinearLayout>


            <!-- Ultra Premium Neumorphic Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/dwnldpdfcv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                android:layout_margin="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/premium_card_bg"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <!-- Card Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="start|center_vertical"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_margin="5dp"
                            android:layout_marginEnd="10dp"
                            app:cardBackgroundColor="#FFF3E0"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_pdf"
                                app:tint="#F57C00" />
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start|center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:gravity="start"
                                android:text="Download PDF"
                                android:textAlignment="textStart"
                                android:textColor="#1A1A1A"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                        </LinearLayout>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal">

                        <!-- Ultra Premium First Image Section -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="5dp">


                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/viewPdf"
                                android:layout_width="wrap_content"
                                android:layout_height="56dp"
                                android:fontFamily="@font/poppins_medium"
                                android:gravity="center"
                                android:text="Download PDF "
                                android:textAlignment="center"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:backgroundTint="#1976D2"
                                app:cornerRadius="16dp"
                                app:elevation="8dp"
                                app:iconGravity="textStart"
                                app:iconPadding="12dp"
                                app:rippleColor="#80FFFFFF" />
                        </LinearLayout>


                    </LinearLayout>




                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <LinearLayout
                android:id="@+id/buttonLL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/downloadPdfCmd"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/danger_button_gradient"
                    android:text="Download PDF"
                    android:elevation="4dp"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ImageButton
                    android:id="@+id/refreshBtnNew"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/refresh"
                    android:fontFamily="sans-serif-medium"
                    android:padding="12dp"
                    android:elevation="6dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>