<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_background2">

    <!-- Header Card -->
    <androidx.cardview.widget.CardView
            android:id="@+id/headerCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:id="@+id/lineralay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp"
                android:gravity="center_vertical"
                android:background="@drawable/gradient_background2">

            <ImageView
                    android:id="@+id/logoImageView"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:src="@drawable/saiservicelogo"
                    android:contentDescription="Logo"
                    android:scaleType="centerInside"
                    android:layout_marginEnd="16dp" />

            <ImageView
                    android:id="@+id/logoutBtn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/logout"
                    android:background="@drawable/logout_button_background"
                    android:padding="8dp"
                    android:elevation="4dp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- NestedScrollView replaces ScrollView to fix nested scroll conflict -->
    <androidx.core.widget.NestedScrollView
            android:id="@+id/outerScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/headerCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <!-- Filters Card (Location / Department) -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                        android:id="@+id/spinnerLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:background="@drawable/title_card_gradient">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PARKING VEHICLE REPORT"
                            android:layout_gravity="center"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:letterSpacing="0.08"
                            android:layout_marginBottom="16dp" />

                    <TextView
                            android:id="@+id/citySpinnerTxtView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select Location"
                            android:textColor="#FFFFFF"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="13sp"
                            android:layout_marginBottom="6dp" />

                    <Spinner
                            android:id="@+id/citySpinner"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/modern_spinner_gradient"
                            android:elevation="2dp" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select Department"
                            android:textColor="#FFFFFF"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="13sp"
                            android:visibility="gone"
                            android:layout_marginBottom="6dp" />

                    <Spinner
                            android:id="@+id/typeSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:visibility="gone"
                            android:background="@drawable/modern_spinner_gradient"
                            android:elevation="2dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Date Selection Card -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Select Date Range"
                            android:textColor="#1A237E"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="16dp" />

                    <!-- Date Picker Buttons -->
                    <LinearLayout
                            android:id="@+id/buttonLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginBottom="12dp">

                        <Button
                                android:id="@+id/fromDatePicker"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:text="FROM DATE"
                                android:background="@drawable/date_picker_button"
                                android:textColor="#FFFFFF"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="13sp"
                                android:elevation="4dp" />

                        <Button
                                android:id="@+id/toDatePicker"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="TO DATE"
                                android:background="@drawable/date_picker_button"
                                android:textColor="#FFFFFF"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="13sp"
                                android:elevation="4dp" />

                    </LinearLayout>

                    <!-- Date Display and Action -->
                    <LinearLayout
                            android:id="@+id/textViewLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                        <TextView
                                android:id="@+id/fromDateLabel"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:background="@drawable/date_display_background"
                                android:hint="FROM DATE"
                                android:textColorHint="#7986CB"
                                android:gravity="center"
                                android:fontFamily="sans-serif"
                                android:textSize="12sp"
                                android:padding="8dp" />

                        <Button
                                android:id="@+id/fetchData"
                                android:layout_width="wrap_content"
                                android:layout_height="52dp"
                                android:layout_marginHorizontal="8dp"
                                android:text="VIEW REPORT"
                                android:background="@drawable/primary_button_modern"
                                android:textColor="#FFFFFF"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="13sp"
                                android:paddingHorizontal="18dp"
                                android:elevation="6dp" />

                        <TextView
                                android:id="@+id/toDateLabel"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:background="@drawable/date_display_background"
                                android:hint="TO DATE"
                                android:textColorHint="#7986CB"
                                android:gravity="center"
                                android:fontFamily="sans-serif"
                                android:textSize="12sp"
                                android:padding="8dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Dashboard: Fleet Overview (fully dynamic — sections and tiles are generated
                 from whatever DEPTALLOTED / VEHTYPE / JOB_CARD_NO values the API returns,
                 nothing is hardcoded here) -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:layout_marginBottom="14dp">

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fleet Overview"
                                android:textColor="#1A1A2E"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif-medium" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Live counts by JC status, department and vehicle type"
                                android:textColor="#9098B1"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <!-- Sections are added programmatically in WorkshopParkingReport.kt via
                         buildDashboard(): "Overall" (TOTAL / JC OPENED / WITHOUT JC),
                         "By Department" (one tile per DEPTALLOTED value) and
                         "By Vehicle Type" (one tile per VEHTYPE value). Each section builds
                         its own horizontally scrolling row, so any number of departments or
                         vehicle types fits without crowding the page. -->
                    <LinearLayout
                            android:id="@+id/dashboardStatsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Report Summary / Send Mail Card -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                        android:id="@+id/viewReportLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:gravity="center"
                        android:background="@drawable/summary_card_background">

                    <TextView
                            android:id="@+id/rowCountTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:hint="Row Count"
                            android:textAlignment="center"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#3F51B5"
                            android:textSize="13sp"
                            android:background="@drawable/count_display_background"
                            android:padding="12dp"
                            android:minWidth="160dp"
                            android:layout_marginBottom="14dp" />

                    <Button
                            android:id="@+id/sendMailBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="50dp"
                            android:layout_gravity="center"
                            android:text="SEND REPORT ON MAIL"
                            android:background="@drawable/primary_button_modern"
                            android:textColor="#FFFFFF"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="13sp"
                            android:paddingHorizontal="18dp"
                            android:drawableStart="@drawable/ic_email"
                            android:drawablePadding="8dp"
                            android:elevation="6dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Data Table Card -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Report Data"
                            android:textColor="#1A237E"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="12dp" />

                    <!-- Job card filter — works on the data already loaded, no re-fetch.
                         Shown only once a result set is on screen. -->
                    <LinearLayout
                            android:id="@+id/jcFilterLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp"
                            android:visibility="gone">

                        <Button
                                android:id="@+id/filterAllBtn"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:text="ALL"
                                android:background="@drawable/date_picker_button"
                                android:textColor="#FFFFFF"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="11sp"
                                android:paddingHorizontal="4dp" />

                        <Button
                                android:id="@+id/filterWithJcBtn"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1.3"
                                android:layout_marginEnd="6dp"
                                android:text="JC OPENED"
                                android:background="@drawable/date_picker_button"
                                android:textColor="#FFFFFF"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="11sp"
                                android:paddingHorizontal="4dp" />

                        <Button
                                android:id="@+id/filterWithoutJcBtn"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1.3"
                                android:text="WITHOUT JC"
                                android:background="@drawable/date_picker_button"
                                android:textColor="#FFFFFF"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="11sp"
                                android:paddingHorizontal="4dp" />

                    </LinearLayout>

                    <!-- Header Table -->
                    <HorizontalScrollView
                            android:id="@+id/headerHorizontalScrollView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:scrollbars="none"
                            android:background="@drawable/table_header_background">

                        <TableLayout
                                android:id="@+id/headerTableLayout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="8dp">
                        </TableLayout>

                    </HorizontalScrollView>

                    <!-- Data Table — only the current page's rows are rendered -->
                    <HorizontalScrollView
                            android:id="@+id/dataHorizontalScrollView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fillViewport="true"
                            android:background="@drawable/table_background">

                        <TableLayout
                                android:id="@+id/tableLayout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="8dp">
                        </TableLayout>

                    </HorizontalScrollView>

                    <!-- Pagination Controls -->
                    <LinearLayout
                            android:id="@+id/paginationLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="14dp"
                            android:visibility="gone">

                        <Button
                                android:id="@+id/prevPageBtn"
                                android:layout_width="wrap_content"
                                android:layout_height="42dp"
                                android:text="‹ PREV"
                                android:background="@drawable/date_picker_button"
                                android:textColor="#FFFFFF"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="12sp"
                                android:paddingHorizontal="16dp" />

                        <TextView
                                android:id="@+id/pageIndicatorTextView"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="8dp"
                                android:text="Page 1 of 1"
                                android:textAlignment="center"
                                android:textColor="#1A237E"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="13sp" />

                        <Button
                                android:id="@+id/nextPageBtn"
                                android:layout_width="wrap_content"
                                android:layout_height="42dp"
                                android:text="NEXT ›"
                                android:background="@drawable/date_picker_button"
                                android:textColor="#FFFFFF"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="12sp"
                                android:paddingHorizontal="16dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Loading Overlay -->
    <RelativeLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

        <androidx.cardview.widget.CardView
                android:id="@+id/progressBarCardView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:gravity="center">

                <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_centerInParent="true"
                        android:visibility="gone"
                        android:indeterminateTint="#3F51B5" />

                <TextView
                        android:id="@+id/TextProgressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        android:text="Data is loading....."
                        android:textColor="#1A237E"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp"
                        android:layout_centerHorizontal="true" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>