<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/harshbg"
        tools:context=".WorkshopStockTaking">

    <!-- ================= TOP BAR ================= -->
    <ImageButton
            android:id="@+id/homepage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/home"
            android:contentDescription="Home"
            app:layout_constraintBottom_toBottomOf="@id/amazonImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/amazonImage" />

    <ImageView
            android:id="@+id/amazonImage"
            android:layout_width="220dp"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:adjustViewBounds="true"
            android:contentDescription="Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/saiservicelogo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    <!-- ================= USER INFO ================= -->
    <LinearLayout
            android:id="@+id/line1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/rounded_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/amazonImage">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USER: "
                android:textColor="@android:color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/usernameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="username"
                android:textColor="#0429F6"
                android:textSize="13sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="LOCATION: "
                android:textColor="@android:color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/locationText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="locId"
                android:textColor="#0429F6"
                android:textSize="13sp"
                android:textStyle="bold" />
    </LinearLayout>

    <!-- ================= SCROLL CONTENT ================= -->
    <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/line1">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

            <!-- Title + Reports -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <TextView
                        android:id="@+id/header"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SERVICE STOCK TAKING"
                        android:textColor="@android:color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                <Button
                        android:id="@+id/viewReportsButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/modern_button_background"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="VIEW REPORTS"
                        android:textSize="12sp" />
            </LinearLayout>

            <!-- ================= BATCH CARD ================= -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/rounded_bg"
                    android:orientation="vertical"
                    android:padding="12dp">

                <!-- Not used in code; hidden to avoid an empty spinner on screen -->
                <Spinner
                        android:id="@+id/cutOffDateSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/modern_spinner_background"
                        android:visibility="gone" />

                <TextView
                        android:id="@+id/batchNameLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Batch Name"
                        android:textColor="@android:color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <EditText
                            android:id="@+id/batchEditText"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/edittext"
                            android:gravity="center"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    <Button
                            android:id="@+id/addBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/modern_button_background"
                            android:text="ADD"
                            android:visibility="gone" />
                </LinearLayout>

                <Spinner
                        android:id="@+id/multipleBatchNameSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/modern_spinner_background"
                        android:visibility="gone" />
            </LinearLayout>

            <!-- ================= SEARCH CARD ================= -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/rounded_bg"
                    android:orientation="vertical"
                    android:padding="12dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Search Vehicle"
                        android:textColor="@android:color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                <Button
                        android:id="@+id/scan_button"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/modern_button_background"
                        android:text="Scan QR Code"
                        android:visibility="gone" />

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                    <Button
                            android:id="@+id/captureVehNo"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/modern_button_background"
                            android:text="Capture Veh No."
                            android:textSize="13sp" />

                    <Button
                            android:id="@+id/enterVehNo"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/modern_button_background"
                            android:text="Enter Veh No."
                            android:textSize="13sp" />
                </LinearLayout>

                <Button
                        android:id="@+id/fetchChassisDataButton"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        android:background="@drawable/modern_button_background"
                        android:text="Enter Chassis No"
                        android:textSize="13sp" />

                <!-- Not shown by code; kept for ID compatibility -->
                <Button
                        android:id="@+id/captureVinNo"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/modern_button_background"
                        android:text="Capture Vin No."
                        android:visibility="gone" />

                <!-- Captured vehicle number -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <TextView
                            android:id="@+id/vehNoTextView"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginTop="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/edittext"
                            android:gravity="center_vertical"
                            android:hint="Vehicle No."
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@android:color/black"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                    <ImageButton
                            android:id="@+id/fetchVehNoTextView"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/search"
                            android:contentDescription="Search vehicle"
                            android:visibility="gone" />
                </LinearLayout>

                <!-- Captured VIN -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <TextView
                            android:id="@+id/vinNoTextView"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginTop="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/edittext"
                            android:gravity="center_vertical"
                            android:hint="Vin No."
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@android:color/black"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                    <ImageButton
                            android:id="@+id/fetchVinNoTextView"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/search"
                            android:contentDescription="Search VIN"
                            android:visibility="gone" />
                </LinearLayout>

                <!-- Chassis / Job card -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <EditText
                            android:id="@+id/chassis_no"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginTop="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/edittext"
                            android:hint="Enter Chassis Number"
                            android:importantForAutofill="no"
                            android:inputType="textCapCharacters"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@android:color/black"
                            android:textSize="15sp"
                            android:visibility="gone" />

                    <ImageButton
                            android:id="@+id/findByChassis"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/search"
                            android:contentDescription="Search chassis"
                            android:visibility="gone" />
                </LinearLayout>

                <!-- VIN type -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <Spinner
                            android:id="@+id/vintypeSpinner"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginTop="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/modern_spinner_background"
                            android:visibility="gone" />

                    <ImageButton
                            android:id="@+id/fetchVinData2"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/search"
                            android:contentDescription="Search VIN"
                            android:visibility="gone" />
                </LinearLayout>

                <!-- Manual vehicle number -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <EditText
                            android:id="@+id/vehNoEditText"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_marginTop="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/edittext"
                            android:hint="Enter Vehicle Number"
                            android:importantForAutofill="no"
                            android:inputType="textCapCharacters"
                            android:maxLength="11"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@android:color/black"
                            android:textSize="15sp"
                            android:visibility="gone" />

                    <ImageButton
                            android:id="@+id/fetchVehNoData"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/search"
                            android:contentDescription="Search vehicle"
                            android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- ================= DETAILS ================= -->
            <TextView
                    android:id="@+id/VinDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            <TextView
                    android:id="@+id/qr_result_textview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/JOB_CARD_NO"
                    style="@style/TextAppearance.AppCompat.Body1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext"
                    android:padding="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:visibility="gone" />

            <TextView
                    android:id="@+id/LOCATION"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext"
                    android:padding="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            <TextView
                    android:id="@+id/trValVin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext"
                    android:padding="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:visibility="gone" />

            <TextView
                    android:id="@+id/trValChassis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext"
                    android:padding="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:visibility="gone" />

            <TextView
                    android:id="@+id/trValEngineNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext"
                    android:padding="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:visibility="gone" />

            <TextView
                    android:id="@+id/trValModelDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext"
                    android:padding="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:visibility="gone" />

            <TextView
                    android:id="@+id/trValVehStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext"
                    android:padding="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:visibility="gone" />

            <TextView
                    android:id="@+id/trValVariantDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext"
                    android:padding="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:visibility="gone" />

            <TextView
                    android:id="@+id/DRIVER_NAME"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext"
                    android:padding="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:visibility="gone" />

            <TextView
                    android:id="@+id/VIN"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext"
                    android:padding="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:visibility="gone" />

            <TextView
                    android:id="@+id/CHASSIS_NUM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext"
                    android:padding="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:visibility="gone" />

            <TextView
                    android:id="@+id/ENGINE_NO"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext"
                    android:padding="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:visibility="gone" />

            <TextView
                    android:id="@+id/MODEL_CD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext"
                    android:padding="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:visibility="gone" />

            <TextView
                    android:id="@+id/VARIANT_CD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext"
                    android:padding="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:visibility="gone" />

            <TextView
                    android:id="@+id/FUEL_DESC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext"
                    android:padding="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:visibility="gone" />

            <TextView
                    android:id="@+id/trValFuelDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext"
                    android:padding="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:visibility="gone" />

            <TextView
                    android:id="@+id/STOCK_TRF_NO"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/edittext"
                    android:padding="10dp"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:visibility="gone" />

            <!-- ================= ACTIONS ================= -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                <!-- Both save buttons share one slot; code shows one at a time -->
                <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1">

                    <Button
                            android:id="@+id/save_button"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/modern_button_background"
                            android:text="SAVE"
                            android:visibility="invisible" />

                    <Button
                            android:id="@+id/save_button2"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/modern_button_background"
                            android:text="SAVE"
                            android:visibility="invisible" />
                </FrameLayout>

                <Button
                        android:id="@+id/refreshButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/modern_button_background"
                        android:text="Refresh"
                        android:visibility="gone" />
            </LinearLayout>

            <!-- Hidden holder for scanned QR value -->
            <EditText
                    android:id="@+id/vin_qr_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>